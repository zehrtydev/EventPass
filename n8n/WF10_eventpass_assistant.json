    {
      "parameters": {
        "jsCode": "const entrada =\n  $('Preparar contexto CHAT').first().json;\n\nconst conversaciones =\n  $('Buscar conversación CHAT')\n    .all()\n    .map(item => item.json)\n    .filter(item => item.conversation_id);\n\nconst abierta = conversaciones.find(c => {\n  return String(c.estado ?? '')\n    .trim()\n    .toUpperCase() === 'ABIERTA';\n});\n\nconst existe = !!abierta;\n\nreturn [{\n  json: {\n    ...entrada,\n\n    conversation_existe: existe,\n\n    conversation_id:\n      existe\n        ? abierta.conversation_id\n        : entrada.conversation_id_nuevo,\n\n    fecha_inicio:\n      existe\n        ? abierta.fecha_inicio\n        : entrada.timestamp,\n\n    fecha_ultima_interaccion:\n      entrada.timestamp,\n\n    estado_conversacion:\n      'ABIERTA'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -96
      ],
      "id": "31e08a8b-c98e-4d71-9a27-2c57a7c876a8",
      "name": "Resolver conversación CHAT",

    {
      "parameters": {
        "jsCode": "const entrada =\n  $('Normalizar entrada CHAT').first().json;\n\nconst eventos =\n  $('Filtrar eventos CHAT')\n    .all()\n    .map(item => item.json)\n    .map(evento => ({\n      evento_id: evento.evento_id,\n      nombre: evento.nombre,\n      categoria: evento.categoria,\n      descripcion: evento.descripcion,\n      fecha: evento.fecha,\n      hora: evento.hora,\n      lugar: evento.lugar,\n      capacidad: evento.capacidad,\n      organizador: evento.organizador,\n      estado: evento.estado\n    }));\n\nreturn [{\n  json: {\n    ...entrada,\n    eventos\n  }\n}];"
      },

      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst conversacion =\n  $('Resolver conversación CHAT').first().json;\n\nreturn {\n  json: {\n    message_id:\n      `msg_${crypto.randomUUID()}`,\n\n    conversation_id:\n      conversacion.conversation_id,\n\n    usuario_id:\n      conversacion.usuario_id,\n\n    visitor_id:\n      conversacion.visitor_id,\n\n    rol:\n      'USER',\n\n    mensaje:\n      conversacion.mensaje,\n\n    timestamp:\n      new Date().toISOString()\n  }\n};"
      },

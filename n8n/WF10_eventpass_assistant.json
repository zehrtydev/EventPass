    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst entrada = $json ?? {};\nconst metadata = entrada.metadata ?? {};\n\nconst mensaje = String(\n  entrada.chatInput ??\n  entrada.message ??\n  entrada.text ??\n  ''\n).trim();\n\nconst sessionId = String(\n  entrada.sessionId ??\n  entrada.session_id ??\n  ''\n).trim();\n\nconst usuarioId = String(\n  metadata.usuario_id ??\n  entrada.usuario_id ??\n  ''\n).trim();\n\nlet visitorId = String(\n  metadata.visitor_id ??\n  entrada.visitor_id ??\n  sessionId ??\n  ''\n).trim();\n\nif (!visitorId && !usuarioId) {\n  visitorId = `visit_${crypto.randomUUID()}`;\n}\n\nreturn [{\n  json: {\n    mensaje,\n    session_id: sessionId,\n\n    usuario_id: usuarioId,\n    visitor_id: visitorId,\n\n    conversation_id_nuevo:\n      `conv_${crypto.randomUUID()}`,\n\n    timestamp:\n      new Date().toISOString(),\n\n    entrada_valida:\n      mensaje.length > 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

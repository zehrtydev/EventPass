    {
      "parameters": {
        "jsCode": "const recordatorio =\n  $('Preparar recordatorio').item.json;\n\nconst estados = [\n  $json.gmail_estado,\n  $json.telegram_estado,\n  $json.whatsapp_estado\n].map(estado => String(estado ?? '').trim().toUpperCase());\n\nconst enviado = estados.some(estado => estado === 'ENVIADO');\n\nreturn {\n  json: {\n    ...recordatorio,\n\n    estado:\n      enviado ? 'ENVIADO' : 'ERROR',\n\n    fecha_envio:\n      enviado\n        ? new Date().toISOString()\n        : ''\n  }\n};"

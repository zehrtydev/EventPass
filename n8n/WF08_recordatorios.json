      "id": "4ceafe94-67f8-4e62-97ff-e09850e40cf1",
      "name": "Sincronizar datos RECORDATORIOS"
    },
    {
      "parameters": {
        "jsCode": "const eventos =\n  $('Leer eventos RECORDATORIOS')\n    .all()\n    .map(item => item.json)\n    .filter(item => item.evento_id);\n\nconst inscripciones =\n  $('Leer inscripciones RECORDATORIOS')\n    .all()\n    .map(item => item.json)\n    .filter(item => item.inscripcion_id);\n\nconst anteriores =\n  $('Leer recordatorios previos')\n    .all()\n    .map(item => item.json)\n    .filter(item => item.recordatorio_id);\n\nconst ahora = new Date();\n\n// Ventana de implementación:\n// recordatorio dentro de las próximas 48 horas.\nconst LIMITE_MS = 48 * 60 * 60 * 1000;\n\nconst tipoRecordatorio = 'EVENTO_48H';\n\nconst candidatos = [];\n\nfor (const evento of eventos) {\n  if (\n    String(evento.estado ?? '')\n      .trim()\n      .toUpperCase() !== 'PUBLICADO'\n  ) {\n    continue;\n  }\n\n  const fecha = String(evento.fecha ?? '').trim();\n  const hora = String(evento.hora ?? '00:00').trim();\n\n  if (!fecha) continue;\n\n  const fechaEvento = new Date(`${fecha}T${hora}:00-05:00`);\n\n  if (Number.isNaN(fechaEvento.getTime())) {\n    continue;\n  }\n\n  const diferenciaMs =\n    fechaEvento.getTime() - ahora.getTime();\n\n  // No enviar si ya ocurrió o faltan más de 48 horas.\n  if (\n    diferenciaMs <= 0 ||\n    diferenciaMs > LIMITE_MS\n  ) {\n    continue;\n  }\n\n  const confirmadas = inscripciones.filter(inscripcion => {\n    return (\n      String(inscripcion.evento_id ?? '').trim() ===\n        String(evento.evento_id ?? '').trim()\n      &&\n      String(inscripcion.estado ?? '')\n        .trim()\n        .toUpperCase() === 'CONFIRMADA'\n    );\n  });\n\n  for (const inscripcion of confirmadas) {\n    const usuarioId =\n      String(inscripcion.usuario_id ?? '').trim();\n\n    const clave =\n      `${usuarioId}:${evento.evento_id}:${tipoRecordatorio}`;\n\nconst yaProcesado = anteriores.some(recordatorio => {\n  return (\n    String(recordatorio.clave_idempotencia ?? '').trim() === clave\n  );\n});\n\n    if (yaProcesado) {\n      continue;\n    }\n\n    candidatos.push({\n      usuario_id: usuarioId,\n\n      evento_id:\n        evento.evento_id,\n\n      inscripcion_id:\n        inscripcion.inscripcion_id,\n\n      tipo_recordatorio:\n        tipoRecordatorio,\n\n      fecha_programada:\n        fechaEvento.toISOString(),\n\n      nombre_evento:\n        evento.nombre ?? '',\n\n      fecha_evento:\n        evento.fecha ?? '',\n\n      hora_evento:\n        evento.hora ?? '',\n\n      lugar:\n        evento.lugar ?? '',\n\n      clave_idempotencia:\n        clave\n    });\n  }\n}\n\nreturn candidatos.map(candidato => ({\n  json: candidato\n}));"
      },

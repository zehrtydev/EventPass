        "jsCode": "const crypto = require('crypto');\n\nreturn {\n  json: {\n    ...$json,\n\n    recordatorio_id:\n      `rem_${crypto.randomUUID()}`,\n\n    estado: 'PENDIENTE',\n\n    fecha_envio: ''\n  }\n};"
      },

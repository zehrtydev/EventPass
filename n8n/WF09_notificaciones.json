    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst usuario_id = String($json.usuario_id ?? '').trim();\nconst tipo = String($json.tipo ?? '').trim().toUpperCase();\nconst titulo = String($json.titulo ?? '').trim();\nconst mensaje = String($json.mensaje ?? '').trim();\n\nconst evento_id = $json.evento_id\n  ? String($json.evento_id).trim()\n  : '';\n\nconst inscripcion_id = $json.inscripcion_id\n  ? String($json.inscripcion_id).trim()\n  : '';\n\nconst clave_idempotencia = $json.clave_idempotencia\n  ? String($json.clave_idempotencia).trim()\n  : [\n      'NOTIF',\n      tipo || 'SIN_TIPO',\n      usuario_id || 'SIN_USUARIO',\n      evento_id || 'SIN_EVENTO',\n      inscripcion_id || 'SIN_INSCRIPCION'\n    ].join(':');\n\nlet error = null;\n\nif (!usuario_id) {\n  error = 'usuario_id es obligatorio';\n} else if (!tipo) {\n  error = 'tipo es obligatorio';\n} else if (!titulo) {\n  error = 'titulo es obligatorio';\n} else if (!mensaje) {\n  error = 'mensaje es obligatorio';\n}\n\nreturn [{\n  json: {\n    ok_input: !error,\n    error,\n\n    notificacion_id: `not_${crypto.randomUUID()}`,\n\n    usuario_id,\n    tipo,\n    titulo,\n    mensaje,\n    evento_id,\n    inscripcion_id,\n\n    fecha: new Date().toISOString(),\n\n    clave_idempotencia\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",

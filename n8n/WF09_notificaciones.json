      "parameters": {
        "jsCode": "const entrada =\n  $('Normalizar notificación').first().json;\n\nconst usuario =\n  $('Buscar usuario NOTIF').first().json;\n\nconst existeUsuario =\n  !!usuario.usuario_id;\n\nconst usuarioActivo =\n  String(usuario.estado ?? '')\n    .trim()\n    .toUpperCase() === 'ACTIVO';\n\nreturn [{\n  json: {\n    ...entrada,\n\n    usuario_existe: existeUsuario,\n    usuario_activo: usuarioActivo,\n\n    nombre:\n      String(usuario.nombre ?? '').trim(),\n\n    email:\n      String(usuario.email_normalizado ?? '').trim()\n  }\n}];"

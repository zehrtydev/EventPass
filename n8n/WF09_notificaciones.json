    {
      "parameters": {
        "jsCode": "const entrada =\n  $('Preparar destinatario NOTIF').first().json;\n\nconst vinculaciones =\n  $('Buscar vinculaciones NOTIF')\n    .all()\n    .map(item => item.json)\n    .filter(item => item.vinculacion_id);\n\nconst telegram = vinculaciones.find(v => {\n  const estado = String(v.estado ?? '')\n    .trim()\n    .toUpperCase();\n\n  const canal = String(v.canal ?? '')\n    .trim()\n    .toUpperCase();\n\n  return estado === 'ACTIVA' && canal === 'TELEGRAM';\n});\n\nreturn [{\n  json: {\n    ...entrada,\n\n    gmail_disponible:\n      !!String(entrada.email ?? '').trim(),\n\n    telegram_disponible:\n      !!telegram?.chat_id,\n\n    chat_id:\n      telegram?.chat_id ?? null,\n\n    vinculacion_id:\n      telegram?.vinculacion_id ?? null\n  }\n}];"
      },

      "id": "c81faa42-08cd-47d9-9da6-c1409182b4fb",
      "name": "Sincronizar datos REASIGNACIÓN"
    },
    {
      "parameters": {
        "jsCode": "const eventos =\n  $('Filtrar eventos REASIGNACIÓN')\n    .all()\n    .map(item => item.json);\n\nconst inscripciones =\n  $('Leer inscripciones REASIGNACIÓN')\n    .all()\n    .map(item => item.json)\n    .filter(item => item.inscripcion_id);\n\nconst promociones = [];\n\nfor (const evento of eventos) {\n  const eventoId =\n    String(evento.evento_id ?? '').trim();\n\n  const capacidad =\n    Number(evento.capacidad ?? 0);\n\n  if (!eventoId || capacidad <= 0) {\n    continue;\n  }\n\n  // -------------------------\n  // Confirmadas actuales\n  // -------------------------\n\n  const confirmadas = inscripciones.filter(inscripcion => {\n    return (\n      String(inscripcion.evento_id ?? '').trim() === eventoId &&\n      String(inscripcion.estado ?? '')\n        .trim()\n        .toUpperCase() === 'CONFIRMADA'\n    );\n  });\n\n  const cuposDisponibles = Math.max(\n    capacidad - confirmadas.length,\n    0\n  );\n\n  if (cuposDisponibles <= 0) {\n    continue;\n  }\n\n  // -------------------------\n  // Lista de espera ordenada\n  // fecha_inscripcion ASC\n  // -------------------------\n\n  const listaEspera = inscripciones\n    .filter(inscripcion => {\n      return (\n        String(inscripcion.evento_id ?? '').trim() === eventoId &&\n        String(inscripcion.estado ?? '')\n          .trim()\n          .toUpperCase() === 'LISTA_ESPERA'\n      );\n    })\n    .sort((a, b) => {\n      return (\n        new Date(a.fecha_inscripcion ?? 0).getTime() -\n        new Date(b.fecha_inscripcion ?? 0).getTime()\n      );\n    });\n\n  const cantidadPromover = Math.min(\n    cuposDisponibles,\n    listaEspera.length\n  );\n\n  for (let i = 0; i < cantidadPromover; i++) {\n    const inscripcion = listaEspera[i];\n\n    promociones.push({\n      inscripcion_id: inscripcion.inscripcion_id,\n      usuario_id: inscripcion.usuario_id,\n      evento_id: inscripcion.evento_id,\n\n      estado_anterior: 'LISTA_ESPERA',\n      estado_nuevo: 'CONFIRMADA',\n\n      orden_lista: i + 1,\n\n      fecha_inscripcion:\n        inscripcion.fecha_inscripcion,\n\n      fecha_actualizacion:\n        new Date().toISOString(),\n\n      nombre_acreditacion:\n        inscripcion.nombre_acreditacion ?? '',\n\n      observaciones:\n        inscripcion.observaciones ?? '',\n\n      origen:\n        inscripcion.origen ?? 'WEB',\n\n      orden_espera:\n        inscripcion.orden_espera ?? ''\n    });\n  }\n}\n\nreturn promociones.map(promocion => ({\n  json: promocion\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,

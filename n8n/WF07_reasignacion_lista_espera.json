      ],
      "id": "314affb3-faa6-4b94-99a2-d854e38958f9",
      "name": "Calcular reasignaciones"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nreturn $input.all().map(item => {\n  const promocion = item.json;\n  const ahora = new Date().toISOString();\n\n  return {\n    json: {\n      ...promocion,\n\n      reasignacion_id:\n        `rea_${crypto.randomUUID()}`,\n\n      fecha_reasignacion: ahora,\n      fecha_actualizacion: ahora\n    }\n  };\n});"
      },

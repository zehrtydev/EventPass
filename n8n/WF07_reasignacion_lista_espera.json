    {
      "parameters": {
        "jsCode": "const promocion =\n  $('Preparar promoción REASIGNACIÓN').item.json;\n\nconst gmail =\n  String($json.gmail_estado ?? '')\n    .trim()\n    .toUpperCase();\n\nconst telegram =\n  String($json.telegram_estado ?? '')\n    .trim()\n    .toUpperCase();\n\nlet resultado = 'ERROR';\n\nif (\n  gmail === 'ENVIADO' &&\n  telegram === 'ENVIADO'\n) {\n  resultado = 'ENVIADO';\n} else if (\n  gmail === 'ENVIADO' ||\n  telegram === 'ENVIADO'\n) {\n  resultado = 'PARCIAL';\n} else if (\n  gmail === 'NO_APLICA' &&\n  telegram === 'NO_APLICA'\n) {\n  resultado = 'NO_APLICA';\n}\n\nreturn {\n  json: {\n    reasignacion_id:\n      promocion.reasignacion_id,\n\n    evento_id:\n      promocion.evento_id,\n\n    inscripcion_id:\n      promocion.inscripcion_id,\n\n    usuario_id:\n      promocion.usuario_id,\n\n    fecha:\n      promocion.fecha_reasignacion,\n\n    orden_lista:\n      promocion.orden_lista,\n\n    estado_anterior:\n      promocion.estado_anterior,\n\n    estado_nuevo:\n      promocion.estado_nuevo,\n\n    resultado_notificacion:\n      resultado\n  }\n};"
      },
